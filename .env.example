# --- Telegram ---------------------------------------------------------------
# Create a bot with @BotFather → /newbot, paste the token here.
TELEGRAM_BOT_TOKEN=

# Public HTTPS URL where this server is reachable (Render/Railway URL or a tunnel).
# Telegram only opens Mini Apps over https.
PUBLIC_URL=https://your-app.onrender.com

# --- Walrus Memory ----------------------------------------------------------
# Generate an account ID + delegate key at https://memory.walrus.xyz
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
# Production (mainnet): https://relayer.memory.walrus.xyz
# Staging   (testnet): https://relayer-staging.memory.walrus.xyz
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE_PREFIX=thesis-keeper

# --- LLM (any OpenAI-compatible API; defaults to an open model on Groq) -----
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b

# --- Users' own Walrus Memory keys (optional feature) ----------------------
# Random secret used to encrypt delegate keys users paste in the app. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
USER_KEY_SECRET=

# --- Misc -------------------------------------------------------------------
PORT=3000
# NODE_ENV=production
# Local browser testing without Telegram (ignored when NODE_ENV=production):
# DEV_USER_ID=1001
# DATA_DIR=data
# MONITOR_INTERVAL_MS=60000
